[Unit]
Description=Timer horário — alerta de mudança na carteira do Erick (task 20260902-053)

[Timer]
# 1 HORA — ordem direta do Samyr (task 20260902-053): "preciso de um scan a cada
# 1h". Era diário às 13:15 UTC (task 20260902-051, argumento: cache de 24h da
# fonte tornava mais frequente inútil) até ele decidir que o custo de um GET a
# mais por hora é irrisório perto de saber da mudança dentro da hora — e o TTL
# de `erick_carteira.py` foi pra 1h junto, senão o timer bateria mas a função
# devolveria o mesmo cache do dia inteiro. O alerta continua em silêncio total
# quando nada muda (DA-034) — 24 disparos/dia sem mensagem é o esperado.
OnCalendar=hourly
Persistent=true
Unit=tg-alertas-carteira.service

[Install]
WantedBy=timers.target
